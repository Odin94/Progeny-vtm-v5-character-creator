{
    "name": "progeny-vtm-v5-character-generator",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build && posthog-cli --dotenv-file .env sourcemap inject --directory ./build --exclude '**/VtM5e_ENG_CharacterSheet_2pMINI_noTxtRichFields-*' && posthog-cli --dotenv-file .env sourcemap upload --directory ./build --exclude '**/VtM5e_ENG_CharacterSheet_2pMINI_noTxtRichFields-*' --release-name progeny-vtm-v5-character-generator --delete-after",
        "serve": "vite preview",
        "lint": "oxlint src",
        "lint:fix": "oxlint src --fix",
        "doctor": "react-doctor --no-telemetry --no-supply-chain --scope full",
        "doctor:changed": "react-doctor --no-telemetry --no-supply-chain --scope changed",
        "fmt": "oxfmt --write .",
        "fmt:check": "oxfmt --check .",
        "pdf-to-base64": "pnpm exec ts-node --project ./scripts/tsconfig.json ./scripts/pdfToBase64.ts",
        "verify:image-optimization": "node ./scripts/verifyImageOptimization.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@dimforge/rapier3d-compat": "0.20.0",
        "@emotion/babel-plugin": "^11.13.5",
        "@emotion/react": "^11.14.0",
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-regular-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/react-fontawesome": "^3.3.1",
        "@jridgewell/trace-mapping": "^0.3.31",
        "@mantine/colors-generator": "^9.2.1",
        "@mantine/core": "^9.2.1",
        "@mantine/emotion": "^9.2.1",
        "@mantine/hooks": "^9.2.1",
        "@mantine/notifications": "^9.2.1",
        "@pdf-lib/fontkit": "^1.1.1",
        "@tabler/icons-react": "^3.44.0",
        "@tanstack/react-query": "^5.100.11",
        "@tanstack/react-router": "^1.170.4",
        "@tanstack/router-devtools": "^1.167.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@workos-inc/authkit-react": "^0.16.1",
        "buffer": "^6.0.3",
        "framer-motion": "^12.39.0",
        "pdf-lib": "^1.17.1",
        "posthog-js": "^1.438.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-markdown": "^10.1.0",
        "three": "0.186.0",
        "typescript": "^6.0.3",
        "web-vitals": "^5.2.0",
        "zod": "^4.6.6",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@posthog/cli": "^0.7.34",
        "@testing-library/dom": "^10.4.1",
        "@types/three": "0.186.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/ui": "^4.1.12",
        "baseline-browser-mapping": "^2.11.0",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "react-doctor": "0.9.17",
        "sharp": "^0.35.5",
        "svgo": "^4.1.0",
        "ts-node": "^10.9.2",
        "vite": "^8.1.6",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "fastq": "1.20.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "packageManager": "pnpm@10.33.0",
    "pnpm": {
        "overrides": {
            "fast-uri@3": "3.1.9",
            "@babel/core": "7.29.6",
            "@opentelemetry/core": "2.8.0",
            "dompurify": "3.4.17",
            "js-yaml": "4.3.2",
            "postcss": "8.5.23",
            "protobufjs": "7.6.5",
            "rollup": "4.59.0",
            "undici": "7.30.1",
            "browserslist@4": "4.28.7",
            "vitest@4": "4.1.12",
            "@vitest/mocker@4": "4.1.12",
            "baseline-browser-mapping@2": "2.11.0",
            "sharp@0": "0.35.5",
            "svgo@4": "4.1.0",
            "seroval@1": "1.6.3",
            "source-map-js@1": "1.2.2",
            "tinypool@2": "2.1.2",
            "vite@8": "8.1.6"
        },
        "onlyBuiltDependencies": [
            "core-js",
            "esbuild",
            "protobufjs"
        ]
    }
}
